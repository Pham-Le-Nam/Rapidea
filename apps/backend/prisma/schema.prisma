model File {
    id              String          @id @default(uuid())
    name            String
    mimeType        String
    size            Int
    userId          String
    folderId        String

    createdAt       DateTime        @default(now())

    user            Users           @relation(fields: [userId], references: [id], onDelete: Cascade)
    folder          Folder          @relation(fields: [folderId], references: [id], onDelete: Cascade)

    transcript      FileTranscript?

    inCourses       FileInCourse[]
    inPosts         FileInPost[]
    tags            FileTag[]

    @@unique([folderId, name])
    @@index([folderId])
    @@map("file")
}

model FileTranscript {
    id              String              @id @default(uuid())
    fileId          String              @unique

    status          TranscriptStatus    @default(NOT_REQUESTED)

    text            String?
    language        String?
    durationSec     Int?

    provider        String?
    model           String?

    errorMessage    String?

    createdAt       DateTime            @default(now())
    updatedAt       DateTime            @updatedAt

    file            File                @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@map("file_transcript")
}

model Tag {
    id              String              @id @default(uuid())
    name            String              @unique
    embedding       Json?
    createdAt       DateTime            @default(now())

    courses         CourseTag[]
    posts           PostTag[]
    files           FileTag[]

    @@map("tag")
}

model CourseTag {
    courseId        String
    tagId           String
    isSuggested     Boolean             @default(false)
    score           Float?
    createdAt       DateTime            @default(now())

    course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
    tag             Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@unique([courseId, tagId])
    @@index([tagId])
    @@map("course_tag")
}

model PostTag {
    postId          String
    tagId           String
    isSuggested     Boolean             @default(false)
    score           Float?
    createdAt       DateTime            @default(now())

    post            Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
    tag             Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@unique([postId, tagId])
    @@index([tagId])
    @@map("post_tag")
}

model FileTag {
    fileId          String
    tagId           String
    isSuggested     Boolean             @default(true)
    score           Float?
    createdAt       DateTime            @default(now())

    file            File                @relation(fields: [fileId], references: [id], onDelete: Cascade)
    tag             Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@unique([fileId, tagId])
    @@index([tagId])
    @@map("file_tag")
}

model FileInCourse {
    fileId          String
    courseId        String
    userId          String

    createdAt       DateTime        @default(now())

    file            File            @relation(fields: [fileId], references: [id], onDelete: Cascade)
    course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
    user            Users           @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([fileId, courseId])
    @@index([courseId])
    @@map("file_in_course")
}

model FileInPost {
    fileId          String
    postId          String
    userId          String

    createdAt       DateTime        @default(now())

    file            File            @relation(fields: [fileId], references: [id], onDelete: Cascade)
    post            Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
    user            Users           @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([fileId, postId])
    @@index([postId])
    @@map("file_in_post")
}

model Photo {
    id              Int             @id @default(autoincrement())
    userId          String
    url             String          @default("photo")
    name            String

    createdAt       DateTime        @default(now())

    user            Users           @relation("UploadedPhoto", fields: [userId], references: [id], onDelete: Cascade)
    userAvatar      Users?          @relation("UserAvatar")
    userBackground  Users?          @relation("UserBackground")
    courseThumbnail Course?         @relation()
    experience      Experience?     @relation()
    education       Education?      @relation()
    project         Project?        @relation()

    @@map("photo")
}
