// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Users {
    id                      String                  @id @default(uuid())
    email                   String                  @unique
    password                String
    firstname               String
    lastname                String
    middlename              String?
    username                String                  @unique
    avatarId                Int?                    @unique
    backgroundId            Int?                    @unique
    headline                String?
    bio                     String?

    postsCount              Int                     @default(0)
    coursesCount            Int                     @default(0)
    followersCount          Int                     @default(0)
    followingCount          Int                     @default(0)
    subscribersCount        Int                     @default(0)
    ratingCount             Int                     @default(0)
    ratingTotal             Float                   @default(0)
    rating                  Float                   @default(0)

    sessionVersion          Int                     @default(0)
    createdAt               DateTime                @default(now())

    avatar                  Photo?                  @relation("UserAvatar", fields: [avatarId], references: [id])
    background              Photo?                  @relation("UserBackground", fields: [backgroundId], references: [id])

    passwordResetTokens     PasswordResetToken[]
    posts                   Post[]
    course                  Course[]
    subscribe               Subscribe[]
    recentCourseViews       RecentCourseView[]
    recentPostViews         RecentPostView[]
    followers               Follow[]                @relation("userFollowers")
    following               Follow[]                @relation("userFollowing")
    conversationsAsUserA    ChatConversation[]      @relation("ConversationUserA")
    conversationsAsUserB    ChatConversation[]      @relation("ConversationUserB")
    sentChatMessages        ChatMessage[]           @relation("SentChatMessages")
    notifications           Notification[]          @relation("UserNotifications")
    triggeredNotifications  Notification[]          @relation("ActorNotifications")
    discussions             Discussion[]
    ratePosts               RatePost[]
    rateDiscussion          RateDiscussion[]
    experience              Experience[]
    educations              Education[]
    projects                Project[]
    projectContributors     ProjectContributor[]
    uploadedFiles           File[]
    uploadedPhotos          Photo[]                 @relation("UploadedPhoto")
    socialLinks             SocialLink[]
    payoutAccount           PayoutAccount?
    FilesInCourses         FileInCourse[]
    FilesInPosts           FileInPost[]
    
    @@map("users")
}

model SocialLink {
    id        String   @id @default(uuid())

    platform  SocialPlatform
    url       String

    userId    String
    user      Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([userId, platform]) // user can only have 1 link per platform
    @@index([userId])
    @@map("social_link")
}

model PayoutAccount {
    id                  String      @id @default(uuid())
    userId              String      @unique
    accountHolderName   String?
    country             String?
    currency            String      @default("AUD")
    payoutMethod        String      @default("BANK")
    bankName            String?
    routingNumber       String?
    accountNumber       String?
    paypalEmail         String?
    taxResidency        String?
    businessType        String      @default("INDIVIDUAL")
    status              String      @default("DRAFT")
    createdAt           DateTime    @default(now())
    updatedAt           DateTime    @updatedAt

    user                Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("payout_account")
}

enum SocialPlatform {
    FACEBOOK
    INSTAGRAM
    TWITTER
    LINKEDIN
    GITHUB
    TIKTOK
    YOUTUBE
    DISCORD
    TELEGRAM
    WEBSITE
}

enum TranscriptStatus {
    NOT_REQUESTED
    PROCESSING
    COMPLETED
    FAILED
}

enum NotificationType {
    FOLLOW
    COURSE_SUBSCRIBE
    COURSE_REVIEW
    POST_RATE
    POST_DISCUSSION
    FOLLOWING_NEW_COURSE
    FOLLOWING_NEW_POST
    SUBSCRIBED_CREATOR_NEW_COURSE
    SUBSCRIBED_CREATOR_NEW_POST
}

model Notification {
    id              String              @id @default(uuid())
    userId          String
    actorId         String?
    type            NotificationType
    title           String
    message         String
    link            String?
    readAt          DateTime?
    createdAt       DateTime            @default(now())

    user            Users               @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
    actor           Users?              @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([userId, readAt, createdAt])
    @@index([actorId])
    @@map("notification")
}

model PasswordResetToken {
    id              String      @id @default(uuid())
    userId          String
    token           String
    expiresAt       DateTime
    used            Boolean     @default(false)
    createdAt       DateTime    @default(now())

    user            Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("password_reset_tokens")
}

model Follow {
    followerId      String
    followingId     String

    follower        Users       @relation("userFollowing", fields: [followerId], references: [id], onDelete: Cascade)
    following       Users       @relation("userFollowers", fields: [followingId], references: [id], onDelete: Cascade)

    createdAt       DateTime    @default(now())

    @@unique([followerId, followingId]) // prevents duplicate follows
    @@index([followingId])
    @@map("follow")
}

model ChatConversation {
    id              String        @id @default(uuid())
    userAId         String
    userBId         String
    lastMessageAt   DateTime      @default(now())
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt

    userA           Users         @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
    userB           Users         @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
    messages        ChatMessage[]

    @@unique([userAId, userBId])
    @@index([userAId, lastMessageAt])
    @@index([userBId, lastMessageAt])
    @@map("chat_conversation")
}

model ChatMessage {
    id              String              @id @default(uuid())
    conversationId  String
    senderId        String
    text            String
    readAt          DateTime?
    createdAt       DateTime            @default(now())

    conversation    ChatConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    sender          Users               @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
    @@index([senderId, createdAt])
    @@map("chat_message")
}

model Course {
    id                  String      @id @default(uuid())
    title               String
    description         String?
    userId              String
    price               Float       @default(0)
    currency            String      @default("AUD")
    thumbnailId         Int?        @unique
    folderId            String      @unique

    subscribersCount    Int         @default(0)
    postsCount          Int         @default(0)
    ratingCount         Int         @default(0)
    ratingTotal         Float       @default(0)
    rating              Float       @default(0)

    createdAt           DateTime    @default(now())
    lastUpdated         DateTime    @default(now())

    user                Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
    thumbnail           Photo?      @relation(fields: [thumbnailId], references: [id])
    folder              Folder      @relation(fields: [folderId], references: [id])

    subscribers         Subscribe[]
    recentViews         RecentCourseView[]
    // folders             FolderInCourse[]
    files               FileInCourse[]
    posts               Post[]
    tags                CourseTag[]


    @@unique([userId, title])   // Prevent 2 courses having the same name
    @@index([userId])
    @@map("course")
}

model Subscribe {
    id              String      @id @default(uuid())

    courseId        String
    userId          String
    review          String?
    rating          Float       @default(0)
    price           Float       @default(0)
    currency        String      @default("AUD")

    createdAt       DateTime    @default(now())

    course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
    subscriber     Users        @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([courseId, userId])
    @@index([courseId])
    @@map("subscribe")
}

model Post {
    id              String      @id @default(uuid())
    title           String?
    content         Json?
    userId          String
    courseId        String?
    isPreview       Boolean     @default(false)

    // rating = ratingTotal / ratingCount
    ratingCount     Int         @default(0)
    ratingTotal     Float       @default(0)
    rating          Float       @default(0)
    createdAt       DateTime    @default(now())
    lastUpdated     DateTime    @default(now())

    user            Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
    course          Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
    
    discussions     Discussion[]
    ratePosts       RatePost[]
    files           FileInPost[]
    recentViews     RecentPostView[]
    tags            PostTag[]

    @@index([userId])
    @@map("post")
}

model RecentCourseView {
    id              String      @id @default(uuid())
    courseId        String
    userId          String
    viewedAt        DateTime    @default(now())

    course          Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
    user            Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([courseId, userId])
    @@index([userId, viewedAt])
    @@map("recent_course_view")
}

model RecentPostView {
    id              String      @id @default(uuid())
    postId          String
    userId          String
    viewedAt        DateTime    @default(now())

    post            Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
    user            Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([postId, userId])
    @@index([userId, viewedAt])
    @@map("recent_post_view")
}

model RatePost {
    id              String      @id @default(uuid())
    postId          String
    userId          String
    rating          Float       @default(5)

    createdAt       DateTime    @default(now())

    post            Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
    user            Users       @relation(fields: [userId], references: [id])

    @@unique([postId, userId])
    @@map("rate_post")
}

model Discussion {
    id                  String              @id @default(uuid())
    discussion          Json
    ratingCount         Int                 @default(0)
    ratingTotal         Float               @default(0)
    rating              Float               @default(5)
    postId              String
    userId              String
    parentId            String?
    repliedId           String?

    createdAt           DateTime            @default(now())

    post                Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
    user                Users               @relation(fields: [userId], references: [id])
    parentDiscussion    Discussion?         @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
    repliedDiscussion   Discussion?         @relation("replying" ,fields: [repliedId], references: [id], onDelete: Cascade)

    rateDiscussion      RateDiscussion[]
    childrenDiscussion  Discussion[]        @relation("parent")
    replyingDiscussions Discussion[]        @relation("replying")

    @@index([postId])
    @@map("discussion")
}

model RateDiscussion {
    id                  String              @id @default(uuid())
    discussionId        String
    userId              String
    rating              Float       

    createdAt           DateTime            @default(now())

    discussion          Discussion          @relation(fields: [discussionId], references: [id], onDelete: Cascade)
    user                Users               @relation(fields: [userId], references: [id])

    @@unique([discussionId, userId])
    @@map("rate_dicussion")
}

model Experience {
    id              String      @id @default(uuid())
    name            String
    position        String?
    role            String?
    startedAt       DateTime?
    endedAt         DateTime?
    location        String?
    achievement     String?
    order           Int
    userId          String
    logoId          Int?        @unique

    createdAt       DateTime    @default(now())

    user            Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
    logo            Photo?      @relation(fields: [logoId], references: [id])

    @@index([userId])
    @@map("experience")
}

model Education {
    id              String      @id @default(uuid())
    name            String
    major           String?
    degree          String?
    startedAt       DateTime?
    endedAt         DateTime?
    location        String?
    achievement     String?
    order           Int         
    userId          String
    logoId          Int?        @unique

    createdAt       DateTime    @default(now())

    user            Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
    logo            Photo?      @relation(fields: [logoId], references: [id])

    @@index([userId])
    @@map("education")
}

model Project {
    id                      String                  @id @default(uuid())
    name                    String
    role                    String
    startedAt               DateTime?
    endedAt                 DateTime?
    details                 String?
    order                   Int
    userId                  String
    logoId                  Int?                    @unique

    createdAt               DateTime                @default(now())

    user                    Users                   @relation(fields: [userId], references: [id], onDelete: Cascade)
    logo                    Photo?                  @relation(fields: [logoId], references: [id])

    projectContributors     ProjectContributor[]
    projectLinks            ProjectLink[]

    @@index([userId])
    @@map("project")
}

model ProjectContributor {
    projectId       String
    userId          String
    role            String

    createdAt       DateTime    @default(now())

    project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user            Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([projectId, userId])
    @@index([projectId])
    @@map("project_contributor")
}

model ProjectLink {
    id              String      @id @default(uuid())
    projectId       String
    name            String
    url             String

    createdAt       DateTime    @default(now())

    project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@map("project_link")
}

model Folder {
    id              String              @id @default(uuid())
    userId          String
    // url             String              @default("")
    name            String
    parentId        String?

    createdAt       DateTime            @default(now())

    parentFolder    Folder?             @relation("ParentChildFolder" ,fields: [parentId], references: [id], onDelete: Cascade)
    course          Course?             @relation()

    // inCourses       FolderInCourse[]
    files           File[]
    childrenFolders Folder[]            @relation("ParentChildFolder")

    @@unique([parentId, name])
    @@index([parentId])
    @@map("folder")
}


