DB_HOST=localhost
DB_PORT=5432
DB_NAME=rapideia_dev
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
DB_SSL=false
DB_SSL_CA_PATH=certs/global-bundle.pem
API_PORT=1234
BACKEND_URL=http://localhost:1234
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_IN=86400

# Storage. Use "local" for development or "s3" for Amazon S3/S3-compatible storage.
STORAGE_DRIVER=local
STORAGE_ROOT=storage
STORAGE_PUBLIC_PATH=storage
# For S3, change this to the bucket/CloudFront public base URL used for photos.
STORAGE_PUBLIC_URL=http://localhost:1234/storage

# Required when STORAGE_DRIVER=s3.
STORAGE_BUCKET=
STORAGE_REGION=ap-southeast-2
STORAGE_KEY_PREFIX=
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300

# Leave these unset for Amazon S3. Set them for MinIO or another S3-compatible provider.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false

# Do not set AWS keys on Elastic Beanstalk; use its EC2 instance profile instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

MAIL_USER=
MAIL_PASSWORD=

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI assistance, media transcription, embeddings, and upload moderation.
OPENAI_API_KEY=
CONTENT_GENERATION_MODEL=gpt-4.1-mini
VIDEO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TEXT_EMBEDDING_MODEL=text-embedding-3-small

# Stripe secret key. Checkout keeps card numbers out of this application.
STRIPE_SECRET_KEY=
